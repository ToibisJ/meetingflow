# MeetingFlow — environment variables
# Copy this file to .env and fill in real values. Never commit .env

# PostgreSQL connection string (Neon)
DATABASE_URL="postgresql://user:password@host.neon.tech/meetingflow?sslmode=require"

# Secret used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="change-me"

# Public base URL of the app
APP_URL="http://localhost:3000"
