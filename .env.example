# MeetingFlow — environment variables
# Copy this file to .env and fill in real values. Never commit .env

# --- required to run at all ------------------------------------------------

# The connection string the app queries through.
# On hosted Postgres use the POOLED string here: a serverless deployment opens
# and drops connections constantly, and an unpooled server runs out of them.
DATABASE_URL="postgresql://user:password@host-pooler.neon.tech/meetingflow?sslmode=require"

# The same database, unpooled. Used only by `prisma migrate deploy`, which takes
# an advisory lock that a pooled connection cannot hold. Leave empty on a plain
# local PostgreSQL, where DATABASE_URL is already a direct connection.
DIRECT_DATABASE_URL=""

# Secret used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="change-me"

# Public base URL of the app
APP_URL="http://localhost:3000"

# --- AI layer --------------------------------------------------------------
# Without this key every AI panel reports itself unavailable and the rest of
# the product keeps working. Nothing silently degrades to a fake answer.

ANTHROPIC_API_KEY=""

# Optional. Defaults to claude-opus-5.
AI_MODEL="claude-opus-5"

# --- Google integration (Gmail + Calendar) ---------------------------------
# Create at https://console.cloud.google.com/apis/credentials
# Authorised redirect URI: ${APP_URL}/api/connections/google/callback
# Scopes used:
#   https://www.googleapis.com/auth/gmail.readonly
#   https://www.googleapis.com/auth/gmail.send
#   https://www.googleapis.com/auth/calendar.events
#   https://www.googleapis.com/auth/calendar.readonly

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Microsoft 365 integration (Outlook mail + calendar) -------------------
# Create at https://portal.azure.com  (Azure Active Directory > App registrations)
# Redirect URI: ${APP_URL}/api/connections/microsoft/callback
# Delegated permissions used:
#   Mail.Read  Mail.Send  Calendars.ReadWrite  offline_access

MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_TENANT_ID="common"

# --- token encryption ------------------------------------------------------
# 32-byte key, hex encoded. Encrypts provider refresh tokens at rest.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

TOKEN_ENCRYPTION_KEY=""
